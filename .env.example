# =============================================================================
#  Running Coach — configuration
#  Copie ce fichier en `.env` (jamais commité) et remplis les valeurs.
#  Seules les variables marquées [REQUIS] sont obligatoires ; tout le reste a
#  une valeur par défaut raisonnable ou désactive simplement la fonctionnalité.
# =============================================================================

# --- Anthropic (Claude) -------------------------------------------------------
# [REQUIS] Clé API : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modèle de tout le reste : conversations, vocaux, débriefs, briefing quotidien, courses, commandes
# (défaut : claude-haiku-5-5, rapide et économique)
CLAUDE_MODEL=claude-haiku-5-5
# Modèle du bilan de la semaine (automatique et /review) uniquement : plus capable pour prendre du recul
# sur la semaine, une fois par semaine. claude-haiku-5-5 ici = tout sur Haiku.
CLAUDE_PLANNING_MODEL=claude-sonnet-5-5
# Tokens max par réponse du modèle, et nombre max d'allers-retours d'outils par message
CLAUDE_MAX_TOKENS=16000
CLAUDE_MAX_TOOL_ROUNDS=25

# --- Telegram -----------------------------------------------------------------
# [REQUIS] Token du bot, fourni par @BotFather
TELEGRAM_BOT_TOKEN=
# [REQUIS pour l'usage normal] Ton id de chat. En conversation privée avec le bot, c'est ton id utilisateur.
# Il sert à deux choses : 1) le bot n'obéit qu'à toi (il peut modifier ton agenda),
# 2) le bot sait à qui envoyer ce qu'il initie lui-même (briefing, débrief, bilan, alertes météo).
# Laisse vide au premier démarrage, envoie un message au bot : il te répond avec l'id à mettre ici.
TELEGRAM_CHAT_ID=

# --- Radicale (CalDAV) --------------------------------------------------------
# [REQUIS] URL COMPLÈTE du calendrier dédié au running (avec son identifiant), ex. :
#   https://radicale.example.com/utilisateur/1a2b3c4d-....-..../
RADICALE_URL=
RADICALE_USER=
RADICALE_PASS=
# Facultatif : URL COMPLÈTE de ton agenda COURSES dédié (distinct de l'agenda d'entraînement).
# /shopping y crée UN événement au créneau de courses voulu, avec la checklist par rayon dans sa
# description. Chaque nouvelle liste remplace la précédente liste à venir du coach ; tes propres
# événements n'y sont jamais touchés. Mêmes identifiants que ci-dessus. Vide = liste dans Telegram
# uniquement. (Ancien nom encore accepté : RADICALE_TASKS_URL.)
RADICALE_SHOPPING_URL=

# --- Dreeve (données sportives, lecture seule) — https://docs.dreeve.app ------
# URL racine de ton instance Dreeve, ex. https://dreeve.example.com
DREEVE_URL=
# Clé API REST (drv_…) : Dreeve → Settings → Security → API access
DREEVE_API_KEY=
# Clé MCP (drvm_…) : Dreeve → Settings → Security → MCP access
# ⚠️ Elle doit AUSSI être définie dans le .env de Dreeve, sinon il refuse toute requête MCP.
DREEVE_MCP_KEY=
# Facultatif : défaut <DREEVE_URL>/mcp (utile pour viser l'URL interne Docker de Dreeve)
DREEVE_MCP_URL=
# Types d'activités considérés comme de la course (vocabulaire Strava)
DREEVE_RUN_TYPES=Run,TrailRun,VirtualRun

# --- Météo (Open-Meteo, sans clé) ---------------------------------------------
# Tes lieux d'entraînement (un ou plusieurs, ex. maison et travail), récupérés en un seul appel.
# Format : « Nom: latitude, longitude | Nom: latitude, longitude ». Vide = météo désactivée.
# Le coach choisit la météo du lieu où tombe chaque séance (jours de bureau → travail).
# Coordonnées : clic droit sur Google Maps / OpenStreetMap.
# Exemple : Maison: 48.8566, 2.3522 | Travail: 48.8920, 2.2370
WEATHER_LOCATIONS=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# --- Alertes météo ------------------------------------------------------------
# Message Telegram si pluie, forte chaleur, fortes rafales ou verglas sont prévus pendant une séance
# planifiée (une fois par risque et par séance), avec un bouton « Adapter », puis un message
# « bonne nouvelle » si la prévision s'améliore. Les variables RAIN_ALERT_* gardent leur nom historique.
# Le lieu de la séance vient de son champ « lieu » (renseigné par le coach), sinon du 1er lieu ci-dessus.
# Fréquence de vérification en minutes ; 0 = désactivé
RAIN_ALERT_CHECK_MINUTES=60
# Séances surveillées : celles qui commencent dans les N prochaines heures. L'alerte part dès que la
# prévision annonce de la pluie : avec 48, tu es prévenu 24 à 48 h avant (sauf prévision qui change tard).
RAIN_ALERT_HOURS_AHEAD=48
# Seuils sur le créneau de la séance : probabilité max (%) ET cumul (mm)
RAIN_ALERT_PROBABILITY=60
RAIN_ALERT_MIN_MM=0.3
# Événements ignorés si leur titre contient un de ces mots (séparés par des virgules)
RAIN_ALERT_SKIP_KEYWORDS=repos,rest,off
# Chaleur : température ressentie max sur le créneau (°C)
WEATHER_ALERT_HEAT_C=28
# Vent : rafales max sur le créneau (km/h)
WEATHER_ALERT_GUST_KMH=50
# Verglas : température min (°C) en dessous de laquelle neige, pluie verglaçante ou sol mouillé alertent
WEATHER_ALERT_FREEZE_C=1

# --- Coach --------------------------------------------------------------------
# Fuseau horaire (heures sans fuseau, briefing, affichage)
COACH_TZ=Europe/Paris
# Heure du briefing matinal (HH:MM) ; off = pas de briefing
BRIEFING_TIME=08:00
# Bilan de la semaine : jour (mon…sun) et heure ; off = pas de bilan automatique (/review reste disponible)
WEEKLY_REVIEW_TIME=sun 19:00
# Stock : heure de la vérification quotidienne des produits frais arrivés à échéance (« Encore là ? ») ; off = jamais
PANTRY_CHECK_TIME=18:00
# Questions « qu'as-tu mangé ? » : heures (environ 1 h après chaque repas), posées seulement si aucun repas n'est noté
# depuis la question précédente (5 h au plus) ; off = jamais
MEAL_CHECK_TIMES=10:30,14:30,21:30
# Messages vocaux : modèle Whisper pour la transcription LOCALE (rien ne sort du serveur).
# tiny / base / small / medium : plus gros = plus précis mais plus lent et plus de RAM ;
# small (~500 Mo, téléchargé au premier vocal dans le volume /data) est un bon compromis sur CPU.
# off = vocaux désactivés.
WHISPER_MODEL=small
# Fréquence de détection des nouveaux runs Dreeve, en minutes ; 0 = désactivé.
# Une simple requête à l'API Dreeve : le modèle n'est appelé que si un nouveau run apparaît.
ACTIVITY_POLL_MINUTES=1
# Nombre de jours que le briefing (re)planifie
PLANNING_HORIZON_DAYS=30
# Nombre de jours d'agenda fournis au coach à chaque message
CALENDAR_CONTEXT_DAYS=45
# Messages de conversation conservés (3 échanges = 6)
HISTORY_MESSAGES=6
# Connaissances de départ du coach, utilisées UNIQUEMENT à la création de sa mémoire.
# Format : « catégorie: texte | catégorie: texte ». Catégories : preference, habitude,
# contrainte, objectif, santé, nutrition, équipement, autre. Ensuite, tout se gère en conversation.
# Exemple : contrainte: Bureau lundi et jeudi, séances légères ces jours-là | objectif: Marathon en avril
COACH_SEED_MEMORY=

# --- Technique ----------------------------------------------------------------
# Port exposé sur l'hôte (endpoint /health)
COACH_PORT=18000
# Dossier de la mémoire persistante (dans Docker : /data, déjà réglé)
COACH_DATA_DIR=data
# Timeout des appels HTTP sortants (secondes) et niveau de logs
HTTP_TIMEOUT=8
LOG_LEVEL=INFO
